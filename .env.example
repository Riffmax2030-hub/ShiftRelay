# ShiftRelay Frontline Productivity Engine & Network
# Environment Configuration

# Application Port & Public Origin (Port 4000 strictly for ShiftRelay)
PORT=4000
NODE_ENV=production
APP_URL=https://app.shiftrelayos.com
WEBSITE_URL=https://shiftrelayos.com
CORS_ALLOWED_ORIGINS=https://shiftrelayos.com,https://www.shiftrelayos.com,https://app.shiftrelayos.com,https://admin.shiftrelayos.com
WEBSITE_HOSTS=shiftrelayos.com,www.shiftrelayos.com
ADMIN_HOSTS=admin.shiftrelayos.com
ALLOW_DEV_FALLBACK=false
ALLOW_DEV_DEMO_AUTH=false

# Server Operational Mode:
# 'demo' = Investor Demo Mode (pre-loaded roles, preview switchers, seeded data)
# 'production' = Clean Production Mode (real worker registrations, zero mock accounts)
DEMO_MODE=false

# PostgreSQL Database (Aurora Multi-Region / PgBouncer / Managed Postgres)
# Leave empty to run with high-concurrency local storage fallback
DATABASE_URL=postgres://shiftrelay_user:shiftrelay_secret@localhost:5432/shiftrelay_prod

# Redis Cache & Pub/Sub (optional for distributed real-time SSE clusters)
REDIS_URL=redis://localhost:6379

# OpenAI API Key (For automated shift summary generation & AI handovers)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security & Session Secrets
SESSION_SECRET=replace_with_a_secure_random_64_char_secret_for_production
CARD_SIGNING_SECRET=replace_with_a_persistent_hmac_secret_for_printed_staff_id_qr_cards
JWT_SECRET=replace_with_a_secure_jwt_secret
# Required on first production deploy to bootstrap owner@shiftrelayos.com in Admin Console
SHIFTRELAY_ADMIN_BOOTSTRAP_PASS=replace_with_a_strong_initial_admin_password

# Frontline Media Upload Limits (in bytes, default 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ShiftRelay OS Enterprise Email & Automated Newsletter Engine (mail.shiftrelayos.com)
SMTP_HOST=mail.shiftrelayos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@shiftrelayos.com
SMTP_PASS=your_app_specific_password_without_spaces
FROM_EMAIL="ShiftRelay OS by Riffmax Technology Limited" <notifications@shiftrelayos.com>
EXECUTIVE_DIGEST_EMAIL=finance@shiftrelayos.com
RESEND_API_KEY=re_your_resend_api_key_optional
