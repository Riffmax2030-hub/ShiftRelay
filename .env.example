# ShiftRelay Frontline Productivity Engine & Network
# Environment Configuration

# Application Port (Port 4000 strictly for ShiftRelay)
PORT=4000
NODE_ENV=production

# Server Operational Mode:
# 'demo' = Investor Demo Mode (pre-loaded roles, preview switchers, seeded data)
# 'production' = Clean Production Mode (real worker registrations, zero mock accounts)
DEMO_MODE=false

# PostgreSQL Database (Aurora Multi-Region / PgBouncer / Managed Postgres)
# Leave empty to run with high-concurrency local storage fallback
DATABASE_URL=postgres://shiftrelay_user:shiftrelay_secret@localhost:5432/shiftrelay_prod

# Redis Cache & Pub/Sub (optional for distributed real-time SSE clusters)
REDIS_URL=redis://localhost:6379

# OpenAI API Key (For automated shift summary generation & AI handovers)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security & Session Secrets
SESSION_SECRET=replace_with_a_secure_random_64_char_secret_for_production
JWT_SECRET=replace_with_a_secure_jwt_secret

# Frontline Media Upload Limits (in bytes, default 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800
